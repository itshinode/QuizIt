<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.QuizIt" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primaryBlue</item>
        <item name="colorPrimaryVariant">@color/primaryBlue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/primaryBlue</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/backgroundGray</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/apexcore_logo</item>

        <item name="windowSplashScreenAnimationDuration">200</item>

        <item name="postSplashScreenTheme">@style/Theme.QuizIt</item>
    </style>
</resources>