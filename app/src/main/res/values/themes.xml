<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.QuizIt" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryBlue</item>
        <item name="colorPrimaryVariant">@color/primaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primaryBlue</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accentIndigo</item>
        <item name="colorSecondaryVariant">@color/accentIndigo</item>
        <item name="colorOnSecondary">@color/white</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surfaceLight</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/apexcore_logo</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.QuizIt</item>
    </style>
</resources>